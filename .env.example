# ------------------------------------------------------------------
# Family Hub configuration. Copy to `.env` and fill in the blanks.
# Never commit your real .env — it contains API keys.
# ------------------------------------------------------------------

# --- Container / host (used by docker-compose.yml) ---
HOST_PORT=3000
DATA_PATH=/mnt/user/appdata/family-hub
TZ=Europe/London

# --- Preview without real services (shows realistic mock data) ---
DEMO_MODE=false

# --- First admin account (only used the very first time the database is created) ---
ADMIN_NAME=Andrew
# 4–8 digits. If left blank a random PIN is generated and printed in the container log.
ADMIN_PIN=

# --- Security ---
# Only set to true if you put Family Hub behind HTTPS (e.g. a reverse proxy).
# On a plain-HTTP LAN it must stay false or browsers will refuse the sign-in cookie.
COOKIE_SECURE=false
SESSION_DAYS=30

# --- Requests ---
# Starting value for the "Require admin approval" toggle (can be changed in Admin > Settings).
REQUIRE_APPROVAL=false

# --- Sonarr (TV) — Settings > General > Security > API Key ---
SONARR_URL=http://192.168.1.200:8989
SONARR_API_KEY=
# Optional defaults (otherwise the first root folder / profile is used, or pick in Admin > Settings)
SONARR_ROOT_FOLDER=
SONARR_QUALITY_PROFILE_ID=

# --- Radarr (films) ---
RADARR_URL=http://192.168.1.200:7878
RADARR_API_KEY=
RADARR_ROOT_FOLDER=
RADARR_QUALITY_PROFILE_ID=

# --- Lidarr (music) ---
LIDARR_URL=http://192.168.1.200:8686
LIDARR_API_KEY=
LIDARR_ROOT_FOLDER=
LIDARR_QUALITY_PROFILE_ID=
LIDARR_METADATA_PROFILE_ID=

# --- Plex ---
PLEX_URL=http://192.168.1.202:32400
# Optional — only needed if your Plex server requires auth for /identity.
PLEX_TOKEN=

# --- Home Assistant ---
HA_URL=http://homeassistant.local:8123
# Profile (bottom-left) > Security > Long-lived access tokens > Create token
HA_TOKEN=
# Comma-separated entity IDs to show (can also be edited in Admin > Settings)
HA_ENTITIES=light.living_room,switch.christmas_tree,sensor.outdoor_temperature,person.andrew

# --- Optional: links shown on the dashboard if they differ from the URLs above ---
# SONARR_PUBLIC_URL=
# RADARR_PUBLIC_URL=
# LIDARR_PUBLIC_URL=
# PLEX_PUBLIC_URL=http://192.168.1.202:32400/web
# HA_PUBLIC_URL=

# Timeout for each call to a service, in milliseconds
SERVICE_TIMEOUT_MS=8000
